      <span class="tag">PyTorch</span><span class="tag">JAX</span><span class="tag">ONNX</span><span class="tag">Intel Loihi 2</span><span class="tag">IBM NorthPole</span><span class="tag">Neuromorphic</span><span class="tag">SNN</span>
    </div>
