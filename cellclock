<script>
(function() {
  const canvas = document.getElementById('cc-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, dpr, cells = [], time = 0, animId;
  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.scale(dpr, dpr); initCells();
  }
  function initCells() {
    cells = [];
    const count = Math.min(Math.floor((W * H) / 8000), 80);
    for (let i = 0; i < count; i++) {
      cells.push({ x:Math.random()*W, y:Math.random()*H, vx:(Math.random()-0.5)*0.2, vy:(Math.random()-0.5)*0.2, r:Math.random()*4+2, pulse:Math.random()*Math.PI*2, speed:Math.random()*0.015+0.008, glow:Math.random()>0.7 });
    }
  }
  function draw() {
    ctx.clearRect(0,0,W,H);
    ctx.fillStyle='#000'; ctx.fillRect(0,0,W,H);
    const grad = ctx.createRadialGradient(W*0.5,H*0.4,0,W*0.5,H*0.4,H*0.7);
    grad.addColorStop(0,'rgba(0,100,60,0.12)'); grad.addColorStop(0.5,'rgba(0,60,40,0.06)'); grad.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle=grad; ctx.fillRect(0,0,W,H);
    for (const c of cells) {
      c.x+=c.vx; c.y+=c.vy; c.pulse+=c.speed;
      if(c.x<-10)c.x=W+10; if(c.x>W+10)c.x=-10; if(c.y<-10)c.y=H+10; if(c.y>H+10)c.y=-10;
      const p=Math.sin(c.pulse)*0.5+0.5;
      if(c.glow) {
        const g=ctx.createRadialGradient(c.x,c.y,0,c.x,c.y,c.r*3);
        g.addColorStop(0,`rgba(134,239,172,${0.15*p})`); g.addColorStop(1,'rgba(134,239,172,0)');
        ctx.fillStyle=g; ctx.beginPath(); ctx.arc(c.x,c.y,c.r*3,0,Math.PI*2); ctx.fill();
        ctx.strokeStyle=`rgba(134,239,172,${0.5*p})`; ctx.lineWidth=0.8;
        ctx.beginPath(); ctx.arc(c.x,c.y,c.r,0,Math.PI*2); ctx.stroke();
      } else {
        ctx.strokeStyle=`rgba(216,216,216,${0.06*p})`; ctx.lineWidth=0.5;
        ctx.beginPath(); ctx.arc(c.x,c.y,c.r,0,Math.PI*2); ctx.stroke();
      }
    }
    const vign=ctx.createRadialGradient(W/2,H/2,H*0.1,W/2,H/2,H*0.9);
    vign.addColorStop(0,'rgba(0,0,0,0)'); vign.addColorStop(1,'rgba(0,0,0,0.85)');
    ctx.fillStyle=vign; ctx.fillRect(0,0,W,H);
    time+=0.003; animId=requestAnimationFrame(draw);
  }
  resize(); draw();
  window.addEventListener('resize',()=>{cancelAnimationFrame(animId);resize();draw();});
})();
const obs=new IntersectionObserver((entries)=>{entries.forEach((e,i)=>{if(e.isIntersecting)setTimeout(()=>e.target.classList.add('visible'),i*60);});},{threshold:0.06});
document.querySelectorAll('.reveal').forEach(el=>obs.observe(el));
</script>
